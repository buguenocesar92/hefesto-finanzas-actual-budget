{
    admin off
    auto_https off
    persist_config off
}
:8080 {
    basic_auth {
        {$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
    }
    header {
        Referrer-Policy no-referrer
        X-Content-Type-Options nosniff
        -Server
    }
    encode zstd gzip
    reverse_proxy app:5006 {
        header_up -Authorization
        header_up -X-Actual-Password
    }
}
